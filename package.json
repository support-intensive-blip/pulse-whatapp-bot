{
  "name": "whatsapp-ai-assistant",
  "version": "1.0.0",
  "description": "Production-ready WhatsApp AI Assistant powered by OpenAI",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "node --watch src/app.js",
    "ingest-kb": "node src/scripts/ingest-knowledge-base.js",
    "pinecone:setup": "node src/scripts/setup-pinecone.js",
    "vertex:setup": "node src/scripts/setup-vertex-vector-search.js",
    "dashboard:install": "npm install --prefix dashboard",
    "dashboard:build": "npm run build --prefix dashboard",
    "dashboard:dev": "npm run dev --prefix dashboard",
    "build": "npm run dashboard:build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "whatsapp",
    "ai",
    "openai",
    "assistant",
    "chatbot"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google-cloud/bigquery": "^8.3.1",
    "@google-cloud/firestore": "^9.0.0",
    "@pinecone-database/pinecone": "^8.0.0",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "fluent-ffmpeg": "^2.1.3",
    "google-auth-library": "^10.7.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "openai": "^4.104.0",
    "pdf-parse": "^1.1.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "web-push": "^3.6.7",
    "whatsapp-web.js": "^1.26.0",
    "winston": "^3.17.0"
  }
}
