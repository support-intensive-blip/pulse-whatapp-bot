# --- WhatsApp via Gallabox (WhatsApp Business API) ---
# API key + secret: Gallabox → Settings → Developer → API Keys.
# GALLABOX_API_KEY=
# GALLABOX_API_SECRET=
# Channel id: Gallabox → Settings → Connect → WhatsApp Channel.
# GALLABOX_CHANNEL_ID=
# GALLABOX_ACCOUNT_ID=
# The WhatsApp Business number connected to that channel, with country code (e.g. 919876543210).
# GALLABOX_PHONE=
# Secret set on the Gallabox webhook (Settings → Webhooks). Required when NODE_ENV=production.
# Point the webhook at https://<your-backend>/webhooks/gallabox with event Message.Received.
# GALLABOX_WEBHOOK_SECRET=
# Optional: which dashboard bot account owns this number (defaults to the admin's).
# GALLABOX_BOT_ACCOUNT_ID=

# Intensive context / topic memory idle TTL (minutes). After idle, mode returns to casual.
CONTEXT_MEMORY_TTL_MINUTES=15

OPENAI_MODEL_SMART=gpt-4o
CHAT_TEMPERATURE=0.2
# Tenglish / Indic → English KB query conversion only (chat replies stay at CHAT_TEMPERATURE)
KB_TRANSLATE_TEMPERATURE=0.4
# Translate non-English user messages to English before KB search (Telugu/Tenglish/Hindi/Hinglish)
# Uses KB_TRANSLATE_MODEL (default: OPENAI_MODEL_SMART) at KB_TRANSLATE_TEMPERATURE
KB_TRANSLATE_MODEL=gpt-4o
KB_TRANSLATE_TEMPERATURE=0.4
# Hybrid retrieval weights (dense vector vs BM25). Re-tune KB_MIN_SEARCH_SCORE after re-index.
KB_HYBRID_DENSE_WEIGHT=0.85
KB_HYBRID_SPARSE_WEIGHT=0.15
# KB_MIN_SEARCH_SCORE=0.05
TEST_API_MAX_CONCURRENT=10

# --- Durable SQLite + deletion guard ---
# SQLITE_ENABLED=true
# Password required to purge/wipe SQLite data (keep this secret).
# SQLITE_DELETION_PASSWORD=change-me-to-a-long-random-secret
# SQLITE_BACKUP_ENABLED=true
# SQLITE_BACKUP_INTERVAL_HOURS=24
# SQLITE_BACKUP_KEEP=14

# --- KB vector store backend ---
# Defaults to 'local': an in-server hybrid index (TF-IDF + BM25), no external service.
# Set to vertex | pinecone only to use a hosted store (fill in the vars below).
# VECTOR_BACKEND=local
# KNOWLEDGE_BASE_PATH=knowledge-base/nxtwave-intensive-brain-memory-kb.txt

# --- Pinecone (only if VECTOR_BACKEND=pinecone) ---
# PINECONE_API_KEY=
# PINECONE_INDEX=pulse-kb
# PINECONE_INTEGRATED=true

# --- Vertex AI Vector Search (remote KB vector store, GCP) ---
# Also used by BigQuery integration (bigqueryService.js) if BQ_ENABLED=true.
# GCP_PROJECT_ID=
# VERTEX_REGION=us-central1
# VERTEX_EMBED_MODEL=text-multilingual-embedding-002
# VERTEX_EMBED_DIMENSIONS=768
# Filled in by `npm run vertex:setup` after provisioning the index/endpoint:
# VERTEX_INDEX_ID=
# VERTEX_INDEX_ENDPOINT_ID=
# VERTEX_DEPLOYED_INDEX_ID=
# VERTEX_INDEX_ENDPOINT_DOMAIN=
# Auth: set GOOGLE_APPLICATION_CREDENTIALS to a service account key file, or
# run `gcloud auth application-default login` for local dev.
# GOOGLE_APPLICATION_CREDENTIALS=
